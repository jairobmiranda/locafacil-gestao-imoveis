# ----- Banco -----
# Desenvolvimento local (docker compose -f docker-compose.dev.yml up -d):
DATABASE_URL="mysql://locafacil:locafacil@localhost:3306/locafacil"
# Producao no CapRover (o host srv-captain--* so resolve dentro da rede do CapRover):
# DATABASE_URL="mysql://locafacil:senha@srv-captain--mariadb:3306/locafacil"

# Banco vazio e descartavel, usado apenas pelo `prisma migrate dev` para validar o
# historico de migrations. Nao guarda dados. Caracteres especiais da senha devem ser
# percent-encoded (@ vira %40, # vira %23).
SHADOW_DATABASE_URL="mysql://locafacil:locafacil@localhost:3306/locafacil_shadow"

# ----- API -----
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS="http://localhost:3001"
# Fuso usado pelos agendadores. Banco e containers ficam em UTC; so o cron conhece o
# horario de Brasilia. Conferir com: node -e "console.log(new Date().toString())"
TZ=America/Sao_Paulo

# ----- Auth -----
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"
JWT_EXPIRES_IN=7d

# ----- MinIO -----
# O arquivo NUNCA trafega direto do navegador para o MinIO: sobe e desce pela API.
# Assim a porta 9000 pode continuar fechada para a internet.
#
# Dev local (docker compose -f docker-compose.dev.yml up -d):
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY="locafacil"
MINIO_SECRET_KEY="locafacil123"
#
# Producao, com a API rodando dentro do CapRover (rede interna, sem passar pela internet):
# MINIO_ENDPOINT=srv-captain--minio
# MINIO_PORT=9000
# MINIO_USE_SSL=false
#
# Dev local apontando para o MinIO da VPS: usar o dominio HTTPS publicado pelo CapRover,
# nunca a porta 9000 exposta.
# MINIO_ENDPOINT=minio.seudominio.com
# MINIO_PORT=443
# MINIO_USE_SSL=true
MINIO_BUCKET=locafacil

# ----- E-mail (SMTP) -----
# Deixe false para registrar no log em vez de enviar de verdade.
EMAIL_ENVIO_ATIVO=false
EMAIL_LOTE=20

# Brevo. O SMTP_USER e o login que aparece em SMTP & API > SMTP, nao o e-mail da conta.
# O endereco usado em SMTP_FROM precisa estar verificado como Sender no painel.
# Plano gratuito: 300 e-mails por dia.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Gestão Aluguel <sisnet@outlook.com.br>"
EMAIL_REPLY_TO="sisnet@outlook.com.br"

# Teste as credenciais sem subir a API: npm run smtp:testar -- voce@exemplo.com
#
# Outros provedores, caso precise trocar:
# Resend:  SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USER=resend  (exige dominio proprio)
# SES:     SMTP_HOST=email-smtp.sa-east-1.amazonaws.com  SMTP_PORT=587
#
# Outlook.com NAO funciona: a Microsoft desativou o SMTP AUTH nas caixas
# (535 5.7.139 SmtpClientAuthentication is disabled for the Mailbox).

# ----- Agendadores -----
# Deixe false na maquina de desenvolvimento para nao gerar cobranca no banco compartilhado.
# Formato cron, 5 campos: minuto hora dia-do-mes mes dia-da-semana. `*` = todos,
# `*/n` = de n em n. Os horarios seguem o fuso definido em TZ, nao o do servidor.
CRONS_ATIVOS=false
CRON_GERAR_COBRANCAS="0 3 * * *"
CRON_MARCAR_ATRASO="0 4 * * *"
CRON_REGUA_COBRANCA="0 5 * * *"
CRON_ENVIO_EMAIL="*/10 * * * *"

# ----- Web -----
# Endereco publico do app, usado nos links enviados por e-mail.
APP_URL="http://localhost:3001"
# Sem prefixo NEXT_PUBLIC: a API so e chamada pelo servidor do Next, entao a URL
# pode mudar por variavel de ambiente sem rebuild da imagem.
API_URL="http://localhost:3000/api"
# No CapRover, use a rede interna (nao passa pela internet):
# API_URL="http://srv-captain--locafacil-api:3000/api"
