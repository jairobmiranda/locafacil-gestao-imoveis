# syntax=docker/dockerfile:1

# ---------- deps ----------
FROM node:22-alpine AS deps
WORKDIR /app
RUN apk add --no-cache openssl
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npm ci

# ---------- builder ----------
FROM node:22-alpine AS builder
WORKDIR /app
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN apk add --no-cache openssl
# /app inteiro: o npm cria os symlinks de .bin dentro do node_modules de cada workspace.
COPY --from=deps /app ./
COPY . .
RUN npx prisma generate \
  && npm run build -w packages/contracts \
  && npm run build -w apps/api

# ---------- runner ----------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN apk add --no-cache openssl \
  && addgroup -g 1001 -S nodejs \
  && adduser -u 1001 -S nestjs -G nodejs

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/contracts/package.json packages/contracts/
# Sem --ignore-scripts: o postinstall do prisma baixa os engines aqui, como root.
# Em runtime o usuario nestjs nao tem permissao de escrita em node_modules.
RUN npm ci --omit=dev

# Client gerado vem do builder porque o runner nao tem devDependencies.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client
COPY --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/prisma ./prisma
COPY --from=builder /app/prisma.config.ts ./

RUN chown -R nestjs:nodejs /app

USER nestjs
EXPOSE 3000
CMD ["sh", "-c", "npx prisma migrate deploy && node apps/api/dist/main.js"]
