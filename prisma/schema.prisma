// LocaFacil, modelagem de dados
// Documentacao completa em .github/modelagem-dados.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Estrategia {
  REVENDA
  LOCACAO
  TERRENO
  USO_PROPRIO
}

enum SituacaoImovel {
  PROSPECCAO
  ADQUIRIDO
  EM_REFORMA
  A_VENDA
  PARA_ALUGAR
  ALUGADO
  VENDIDO
}

enum TipoImovel {
  APARTAMENTO
  CASA
  TERRENO
  COMERCIAL
  RURAL
}

enum Natureza {
  ENTRADA
  SAIDA
}

enum SituacaoLancamento {
  PENDENTE
  PAGO
  ATRASADO
  PARCIAL
  CANCELADO
}

enum OrigemLancamento {
  MANUAL
  CONTRATO_AUTOMATICO
}

enum FormaPagamento {
  PIX
  TED
  DINHEIRO
  BOLETO
  CARTAO
}

enum SituacaoContrato {
  RASCUNHO
  EM_ASSINATURA
  ATIVO
  ENCERRADO
  RESCINDIDO
}

enum FinalidadeLocacao {
  RESIDENCIAL
  NAO_RESIDENCIAL
  TEMPORADA
}

enum IndiceReajuste {
  IGPM
  IPCA
  INCC
  NENHUM
}

enum TipoGarantia {
  CAUCAO
  FIADOR
  SEGURO_FIANCA
  TITULO_CAPITALIZACAO
  NENHUMA
}

enum PapelParte {
  LOCADOR
  LOCATARIO
  FIADOR
  CONJUGE
  ANUENTE
  TESTEMUNHA
}

enum EstadoCivil {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  SEPARADO
}

enum SituacaoMinuta {
  RASCUNHO
  GERADA
  ENVIADA_ASSINATURA
  ASSINADA
  CANCELADA
}

enum TipoVistoria {
  ENTRADA
  SAIDA
  PERIODICA
}

enum SituacaoVistoria {
  RASCUNHO
  CONVITE_ENVIADO
  EM_EXECUCAO
  ENVIADA
  APROVADA
  RECUSADA
}

enum EstadoItemVistoria {
  NOVO
  BOM
  REGULAR
  RUIM
  AUSENTE
  NAO_APLICAVEL
}

enum SituacaoNotificacao {
  PENDENTE
  ENVIADO
  FALHOU
  IGNORADO
  CANCELADO
}

enum SituacaoAvisoPagamento {
  PENDENTE
  ACEITO
  RECUSADO
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

enum EntidadeAnexo {
  IMOVEL
  LANCAMENTO
  CONTRATO
  PESSOA
  VISTORIA
}

enum EspecieAnexo {
  COMPROVANTE
  NOTA_FISCAL
  CONTRATO
  FOTO
  ESCRITURA
  LAUDO
  MINUTA
  CONTRATO_ASSINADO
  DOCUMENTO_PESSOAL
  OUTRO
}

enum PerfilUsuario {
  ADMIN
  OPERADOR
  LEITURA
}

enum TipoConfiguracao {
  TEXTO
  NUMERO
  BOOLEANO
  JSON
}

// ---------------------------------------------------------------------------
// Bloco 1: Patrimonio
// ---------------------------------------------------------------------------

model Imovel {
  id       String         @id @default(uuid()) @db.Char(36)
  apelido  String         @db.VarChar(80)
  estrategia Estrategia
  situacao SituacaoImovel @default(PROSPECCAO)
  tipo     TipoImovel

  cep         String? @db.VarChar(9)
  logradouro  String? @db.VarChar(150)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(80)
  bairro      String? @db.VarChar(80)
  cidade      String? @db.VarChar(80)
  uf          String? @db.Char(2)

  matricula          String? @map("matricula") @db.VarChar(50)
  inscricaoMunicipal String? @map("inscricao_municipal") @db.VarChar(50)

  areaTotal      Decimal? @map("area_total") @db.Decimal(10, 2)
  areaConstruida Decimal? @map("area_construida") @db.Decimal(10, 2)
  quartos        Int?
  banheiros      Int?
  vagas          Int?

  dataAquisicao  DateTime? @map("data_aquisicao") @db.Date
  valorAquisicao Decimal?  @map("valor_aquisicao") @db.Decimal(14, 2)
  dataVenda      DateTime? @map("data_venda") @db.Date
  valorVenda     Decimal?  @map("valor_venda") @db.Decimal(14, 2)

  valorVendaAlvo Decimal? @map("valor_venda_alvo") @db.Decimal(14, 2)
  aluguelAlvo    Decimal? @map("aluguel_alvo") @db.Decimal(14, 2)

  observacoes String? @db.Text

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  arquivadoEm  DateTime? @map("arquivado_em")

  lancamentos     Lancamento[]
  contratos       Contrato[]
  vistorias       Vistoria[]
  caracteristicas CaracteristicaImovel[]

  @@index([situacao])
  @@index([estrategia])
  @@index([arquivadoEm])
  @@map("imoveis")
}

/// Comodo ou diferencial que varia de imovel para imovel (suite, quintal, churrasqueira...).
/// Quartos, banheiros e vagas ficam em colunas proprias por serem universais e contaveis.
model CaracteristicaImovel {
  id         String @id @default(uuid()) @db.Char(36)
  imovelId   String @map("imovel_id") @db.Char(36)
  descricao  String @db.VarChar(80)
  quantidade Int?
  ordem      Int    @default(0)

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([imovelId])
  @@map("caracteristicas_imovel")
}

/// Cadastro unico para inquilino, fiador, comprador e fornecedor.
/// O papel vem do relacionamento, nao de um campo de tipo.
model Pessoa {
  id             String    @id @default(uuid()) @db.Char(36)
  nome           String    @db.VarChar(150)
  documento      String?   @unique @db.VarChar(18)
  email          String?   @db.VarChar(150)
  telefone       String?   @db.VarChar(20)
  dataNascimento DateTime? @map("data_nascimento") @db.Date

  /// Qualificacao usada no preambulo do contrato.
  rg             String?      @db.VarChar(20)
  orgaoExpedidor String?      @map("orgao_expedidor") @db.VarChar(20)
  nacionalidade  String?      @db.VarChar(40)
  estadoCivil    EstadoCivil? @map("estado_civil")
  profissao      String?      @db.VarChar(80)

  cep         String? @db.VarChar(9)
  logradouro  String? @db.VarChar(150)
  numero      String? @db.VarChar(20)
  complemento String? @db.VarChar(80)
  bairro      String? @db.VarChar(80)
  cidade      String? @db.VarChar(80)
  uf          String? @db.Char(2)

  observacoes String? @db.Text

  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  arquivadoEm  DateTime? @map("arquivado_em")

  lancamentos     Lancamento[]
  partesContrato  ParteContrato[]
  vistorias       Vistoria[]

  @@index([email])
  @@index([nome])
  @@map("pessoas")
}

// ---------------------------------------------------------------------------
// Bloco 2: Financeiro
// ---------------------------------------------------------------------------

model Categoria {
  id                  String   @id @default(uuid()) @db.Char(36)
  nome                String   @db.VarChar(80)
  natureza            Natureza
  categoriaPaiId      String?  @map("categoria_pai_id") @db.Char(36)
  capitalizavelPadrao Boolean  @default(false) @map("capitalizavel_padrao")
  codigoFiscal        String?  @map("codigo_fiscal") @db.VarChar(20)
  doSistema           Boolean  @default(false) @map("do_sistema")
  ativa               Boolean  @default(true)

  categoriaPai Categoria?  @relation("CategoriaHierarquia", fields: [categoriaPaiId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subcategorias Categoria[] @relation("CategoriaHierarquia")

  lancamentos      Lancamento[]
  itensLancamento  ItemLancamento[]
  itensContrato    ItemContrato[]

  @@unique([nome, natureza])
  @@index([natureza, ativa])
  @@map("categorias")
}

/// Nucleo do sistema. Representa tanto uma cobranca futura quanto um
/// lancamento ja realizado.
model Lancamento {
  id          String  @id @default(uuid()) @db.Char(36)
  imovelId    String  @map("imovel_id") @db.Char(36)
  contratoId  String? @map("contrato_id") @db.Char(36)
  categoriaId String  @map("categoria_id") @db.Char(36)
  pessoaId    String? @map("pessoa_id") @db.Char(36)

  natureza Natureza
  situacao SituacaoLancamento @default(PENDENTE)
  origem   OrigemLancamento   @default(MANUAL)

  descricao   String    @db.VarChar(200)
  valor       Decimal   @db.Decimal(14, 2)
  competencia DateTime  @db.Date
  vencimento  DateTime? @db.Date
  pagoEm      DateTime? @map("pago_em")
  valorPago   Decimal?  @map("valor_pago") @db.Decimal(14, 2)

  valorMulta    Decimal @default(0) @map("valor_multa") @db.Decimal(14, 2)
  valorJuros    Decimal @default(0) @map("valor_juros") @db.Decimal(14, 2)
  valorDesconto Decimal @default(0) @map("valor_desconto") @db.Decimal(14, 2)

  capitalizavel  Boolean         @default(false)
  formaPagamento FormaPagamento?

  pixTxid    String? @unique @map("pix_txid") @db.VarChar(25)
  pixPayload String? @map("pix_payload") @db.Text

  /// Preenchida apenas na geracao automatica, no formato `{contratoId}:{AAAA-MM}`.
  /// MySQL permite multiplos NULL em indice unico, entao lancamentos manuais nao colidem.
  chaveGeracao String? @unique @map("chave_geracao") @db.VarChar(60)

  observacoes String? @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  imovel    Imovel     @relation(fields: [imovelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contrato  Contrato?  @relation(fields: [contratoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categoria Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pessoa    Pessoa?    @relation(fields: [pessoaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  itens         ItemLancamento[]
  notificacoes  Notificacao[]
  avisosPagamento AvisoPagamento[]

  @@index([imovelId, competencia])
  @@index([situacao, vencimento])
  @@index([contratoId, competencia])
  @@index([categoriaId])
  @@index([capitalizavel])
  @@map("lancamentos")
}

/// Decomposicao opcional do lancamento. Usada nas cobrancas de aluguel para
/// separar aluguel, condominio e IPTU.
model ItemLancamento {
  id           String  @id @default(uuid()) @db.Char(36)
  lancamentoId String  @map("lancamento_id") @db.Char(36)
  categoriaId  String  @map("categoria_id") @db.Char(36)
  descricao    String  @db.VarChar(150)
  valor        Decimal @db.Decimal(14, 2)
  ordem        Int     @default(0)

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoria  Categoria  @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([lancamentoId])
  @@index([categoriaId])
  @@map("itens_lancamento")
}

// ---------------------------------------------------------------------------
// Bloco 3: Locacao
// ---------------------------------------------------------------------------

model Contrato {
  id         String            @id @default(uuid()) @db.Char(36)
  imovelId   String            @map("imovel_id") @db.Char(36)
  situacao   SituacaoContrato  @default(RASCUNHO)
  finalidade FinalidadeLocacao @default(RESIDENCIAL)

  dataInicio   DateTime  @map("data_inicio") @db.Date
  dataFim      DateTime  @map("data_fim") @db.Date
  dataRescisao DateTime? @map("data_rescisao") @db.Date

  /// 1 a 31. Ajustado ao ultimo dia do mes quando o dia nao existir.
  diaVencimento Int     @map("dia_vencimento") @db.TinyInt
  valorAluguel  Decimal @map("valor_aluguel") @db.Decimal(14, 2)

  percentualMulta      Decimal @default(2.00) @map("percentual_multa") @db.Decimal(5, 2)
  percentualJurosDia   Decimal @default(0.0330) @map("percentual_juros_dia") @db.Decimal(6, 4)
  descontoPontualidade Decimal @default(0) @map("desconto_pontualidade") @db.Decimal(14, 2)

  indiceReajuste         IndiceReajuste @default(IGPM) @map("indice_reajuste")
  intervaloReajusteMeses Int            @default(12) @map("intervalo_reajuste_meses")
  proximoReajusteEm      DateTime?      @map("proximo_reajuste_em") @db.Date

  tipoGarantia  TipoGarantia @default(NENHUMA) @map("tipo_garantia")
  valorGarantia Decimal?     @map("valor_garantia") @db.Decimal(14, 2)

  chavePixId      String? @map("chave_pix_id") @db.Char(36)
  reguaCobrancaId String? @map("regua_cobranca_id") @db.Char(36)

  diasAvisoEncerramento   Int     @default(90) @map("dias_aviso_encerramento")
  gerarCobrancas          Boolean @default(true) @map("gerar_cobrancas")
  diasAntecedenciaGeracao Int     @default(10) @map("dias_antecedencia_geracao")

  /// Copias das cobrancas, separadas por ponto e virgula. Ex.: conjuge do inquilino.
  emailsCopia String? @map("emails_copia") @db.VarChar(500)

  /// Escolhas do wizard de blindagem. Define quais clausulas entram na minuta.
  respostasBlindagem Json? @map("respostas_blindagem")

  observacoes String? @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  imovel        Imovel         @relation(fields: [imovelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  chavePix      ChavePix?      @relation(fields: [chavePixId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reguaCobranca ReguaCobranca? @relation(fields: [reguaCobrancaId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  itens        ItemContrato[]
  partes       ParteContrato[]
  lancamentos  Lancamento[]
  notificacoes Notificacao[]
  minutas      MinutaContrato[]
  vistorias    Vistoria[]

  @@index([imovelId, situacao])
  @@index([situacao])
  @@index([proximoReajusteEm])
  @@index([dataFim])
  @@map("contratos")
}

/// Template dos encargos recorrentes. A cada mes vira ItemLancamento.
model ItemContrato {
  id          String  @id @default(uuid()) @db.Char(36)
  contratoId  String  @map("contrato_id") @db.Char(36)
  categoriaId String  @map("categoria_id") @db.Char(36)
  descricao   String  @db.VarChar(150)
  valor       Decimal @db.Decimal(14, 2)
  ativo       Boolean @default(true)

  contrato  Contrato  @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoria Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([contratoId])
  @@map("itens_contrato")
}

model ParteContrato {
  id               String     @id @default(uuid()) @db.Char(36)
  contratoId       String     @map("contrato_id") @db.Char(36)
  pessoaId         String     @map("pessoa_id") @db.Char(36)
  papel            PapelParte
  contatoPrincipal Boolean    @default(false) @map("contato_principal")

  /// Percentual do locador sobre o imovel. A soma dos locadores deve fechar 100.
  participacao Decimal? @db.Decimal(5, 2)
  solidario    Boolean  @default(true)
  ordem        Int      @default(0)

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pessoa   Pessoa   @relation(fields: [pessoaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([contratoId, pessoaId, papel])
  @@index([pessoaId])
  @@map("partes_contrato")
}

/// Fotografia do contrato em determinado momento, ja renderizada.
/// Depois de sair de RASCUNHO nunca e regerada: alteracao cria nova versao.
model MinutaContrato {
  id         String         @id @default(uuid()) @db.Char(36)
  contratoId String         @map("contrato_id") @db.Char(36)
  versao     Int
  situacao   SituacaoMinuta @default(GERADA)

  modeloVersao Int  @map("modelo_versao")
  /// Tudo que foi usado na renderizacao, para auditoria.
  dadosSnapshot   Json @map("dados_snapshot")
  /// Array de { id, versao } das clausulas efetivamente incluidas.
  clausulasUsadas Json @map("clausulas_usadas")

  conteudoHtml String @map("conteudo_html") @db.LongText
  hashConteudo String @map("hash_conteudo") @db.Char(64)

  nivelProtecao Int   @default(0) @map("nivel_protecao")
  alertas       Json?

  enviadaEm   DateTime? @map("enviada_em")
  assinadaEm  DateTime? @map("assinada_em")
  canceladaEm DateTime? @map("cancelada_em")

  /// PDF assinado devolvido pelo assinador externo.
  anexoAssinadoId String? @map("anexo_assinado_id") @db.Char(36)
  hashAssinado    String? @map("hash_assinado") @db.Char(64)

  criadoEm DateTime @default(now()) @map("criado_em")

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([contratoId, versao])
  @@index([situacao])
  @@map("minutas_contrato")
}

// ---------------------------------------------------------------------------
// Bloco 3.1: Vistoria
// ---------------------------------------------------------------------------

model Vistoria {
  id         String           @id @default(uuid()) @db.Char(36)
  imovelId   String           @map("imovel_id") @db.Char(36)
  contratoId String?          @map("contrato_id") @db.Char(36)
  tipo       TipoVistoria
  situacao   SituacaoVistoria @default(RASCUNHO)

  roteiroChave  String @map("roteiro_chave") @db.VarChar(40)
  roteiroVersao Int    @map("roteiro_versao")

  /// Quem vai executar. Normalmente o proprio locatario.
  responsavelId    String? @map("responsavel_id") @db.Char(36)
  conviteEmail     String? @map("convite_email") @db.VarChar(150)
  conviteEnviadoEm DateTime? @map("convite_enviado_em")
  conviteExpiraEm  DateTime? @map("convite_expira_em")

  iniciadaEm DateTime? @map("iniciada_em")
  enviadaEm  DateTime? @map("enviada_em")
  aprovadaEm DateTime? @map("aprovada_em")
  recusadaEm DateTime? @map("recusada_em")
  motivoRecusa String? @map("motivo_recusa") @db.VarChar(500)

  /// Quem acompanha esta vistoria por e-mail. Separados por ponto e virgula.
  avisarEmails    String? @map("avisar_emails") @db.VarChar(500)
  avisarInicio    Boolean @default(false) @map("avisar_inicio")
  avisarConclusao Boolean @default(false) @map("avisar_conclusao")

  /// Carimbo de envio de cada aviso. Serve de trava: cada um sai uma vez so.
  avisoInicioEm    DateTime? @map("aviso_inicio_em")
  avisoConclusaoEm DateTime? @map("aviso_conclusao_em")

  observacoes String? @db.Text

  laudoAnexoId String? @map("laudo_anexo_id") @db.Char(36)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  imovel      Imovel    @relation(fields: [imovelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contrato    Contrato? @relation(fields: [contratoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  responsavel Pessoa?   @relation(fields: [responsavelId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  ambientes VistoriaAmbiente[]

  @@index([imovelId, tipo])
  @@index([contratoId])
  @@index([situacao])
  @@map("vistorias")
}

model VistoriaAmbiente {
  id         String  @id @default(uuid()) @db.Char(36)
  vistoriaId String  @map("vistoria_id") @db.Char(36)
  chave      String  @db.VarChar(40)
  nome       String  @db.VarChar(80)
  ordem      Int
  concluido  Boolean @default(false)

  vistoria Vistoria       @relation(fields: [vistoriaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  itens    VistoriaItem[]

  @@index([vistoriaId])
  @@map("vistoria_ambientes")
}

model VistoriaItem {
  id          String              @id @default(uuid()) @db.Char(36)
  ambienteId  String              @map("ambiente_id") @db.Char(36)
  chave       String              @db.VarChar(40)
  nome        String              @db.VarChar(100)
  dica        String?             @db.VarChar(200)
  ordem       Int
  minimoFotos Int                 @default(1) @map("minimo_fotos")
  estado      EstadoItemVistoria?
  observacao  String?             @db.Text

  ambiente VistoriaAmbiente @relation(fields: [ambienteId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  fotos    VistoriaFoto[]

  @@index([ambienteId])
  @@map("vistoria_itens")
}

/// Nao reusa Anexo: a prova depende de EXIF, coordenada, ordem e dimensoes.
model VistoriaFoto {
  id           String @id @default(uuid()) @db.Char(36)
  itemId       String @map("item_id") @db.Char(36)
  bucket       String @db.VarChar(63)
  chaveObjeto  String @map("chave_objeto") @db.VarChar(500)
  tipoConteudo String @map("tipo_conteudo") @db.VarChar(100)
  tamanhoBytes Int    @map("tamanho_bytes")
  largura      Int?
  altura       Int?
  hashSha256   String @map("hash_sha256") @db.Char(64)

  /// Vem do EXIF do aparelho, pode ser adulterado. Serve de indicio, nao de prova.
  capturadaEm DateTime? @map("capturada_em")
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)

  /// Carimbo do servidor. Esta e a data que vale.
  recebidaEm DateTime @default(now()) @map("recebida_em")

  ordem   Int     @default(0)
  legenda String? @db.VarChar(200)

  item VistoriaItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([itemId])
  @@map("vistoria_fotos")
}

// ---------------------------------------------------------------------------
// Bloco 4: Automacao
// ---------------------------------------------------------------------------

model ModeloEmail {
  id                   String  @id @default(uuid()) @db.Char(36)
  chave                String  @unique @db.VarChar(50)
  nome                 String  @db.VarChar(100)
  assunto              String  @db.VarChar(200)
  corpoHtml            String  @map("corpo_html") @db.Text
  corpoTexto           String? @map("corpo_texto") @db.Text
  variaveisDisponiveis Json?   @map("variaveis_disponiveis")
  ativo                Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  regras       RegraCobranca[]
  notificacoes Notificacao[]
  reguasConsolidado ReguaCobranca[] @relation("ModeloConsolidado")

  @@map("modelos_email")
}

model ReguaCobranca {
  id     String  @id @default(uuid()) @db.Char(36)
  nome   String  @db.VarChar(100)
  padrao Boolean @default(false)
  ativa  Boolean @default(true)

  /// Usado quando o inquilino tem mais de uma cobranca vencendo no mesmo disparo.
  /// Sem modelo definido, cada cobranca sai em um e-mail proprio.
  modeloConsolidadoId String? @map("modelo_consolidado_id") @db.Char(36)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  modeloConsolidado ModeloEmail? @relation("ModeloConsolidado", fields: [modeloConsolidadoId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  regras    RegraCobranca[]
  contratos Contrato[]

  @@index([padrao])
  @@map("reguas_cobranca")
}

/// Cada etapa da regua. E aqui que a parametrizacao acontece.
model RegraCobranca {
  id        String @id @default(uuid()) @db.Char(36)
  reguaId   String @map("regua_id") @db.Char(36)
  sequencia Int

  /// Negativo dispara antes do vencimento, 0 no dia, positivo em atraso.
  diasOffset             Int  @map("dias_offset")
  /// Nulo dispara uma unica vez.
  intervaloRepeticaoDias Int? @map("intervalo_repeticao_dias")
  maximoRepeticoes       Int? @map("maximo_repeticoes")

  modeloEmailId String @map("modelo_email_id") @db.Char(36)

  /// Formato HH:mm.
  horaEnvio         String              @default("09:00") @map("hora_envio") @db.Char(5)
  apenasSeSituacao  SituacaoLancamento? @map("apenas_se_situacao")
  ativa             Boolean             @default(true)

  regua        ReguaCobranca @relation(fields: [reguaId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  modeloEmail  ModeloEmail   @relation(fields: [modeloEmailId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notificacoes Notificacao[]

  @@unique([reguaId, sequencia])
  @@index([ativa])
  @@map("regras_cobranca")
}

/// Fila de envio e log de auditoria na mesma tabela.
model Notificacao {
  id              String  @id @default(uuid()) @db.Char(36)
  lancamentoId    String? @map("lancamento_id") @db.Char(36)
  contratoId      String? @map("contrato_id") @db.Char(36)
  regraCobrancaId String? @map("regra_cobranca_id") @db.Char(36)
  modeloEmailId   String  @map("modelo_email_id") @db.Char(36)

  /// 1 no primeiro disparo, incrementa a cada repeticao da mesma regra.
  ocorrencia Int @default(1)

  destinatario     String  @db.VarChar(150)
  copia            String? @db.VarChar(500)
  assunto          String  @db.VarChar(200)
  corpoRenderizado String  @map("corpo_renderizado") @db.Text

  agendadoPara DateTime            @map("agendado_para")
  enviadoEm    DateTime?           @map("enviado_em")
  situacao     SituacaoNotificacao @default(PENDENTE)
  tentativas   Int                 @default(0)
  mensagemErro String?             @map("mensagem_erro") @db.Text
  idProvedor   String?             @map("id_provedor") @db.VarChar(200)

  /// Pix somado do e-mail consolidado, que nao pertence a nenhum lancamento isolado.
  pixPayload String? @map("pix_payload") @db.Text

  criadoEm DateTime @default(now()) @map("criado_em")

  lancamento    Lancamento?    @relation(fields: [lancamentoId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  contrato      Contrato?      @relation(fields: [contratoId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  regraCobranca RegraCobranca? @relation(fields: [regraCobrancaId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  modeloEmail   ModeloEmail    @relation(fields: [modeloEmailId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Garantia de idempotencia: mesmo que o cron rode duas vezes,
  /// o inquilino nao recebe cobranca duplicada.
  @@unique([lancamentoId, regraCobrancaId, ocorrencia])
  @@index([situacao, agendadoPara])
  @@map("notificacoes")
}

/// Pagamento informado pelo inquilino no link publico. Nao da baixa sozinho:
/// serve de aviso para o gestor conferir e confirmar.
model AvisoPagamento {
  id           String @id @default(uuid()) @db.Char(36)
  lancamentoId String @map("lancamento_id") @db.Char(36)

  pagoEm         DateTime       @map("pago_em") @db.Date
  valor          Decimal        @db.Decimal(14, 2)
  formaPagamento FormaPagamento @map("forma_pagamento")
  observacoes    String?        @db.VarChar(500)

  /// Comprovante enviado junto, quando houver.
  anexoId String? @map("anexo_id") @db.Char(36)

  situacao SituacaoAvisoPagamento @default(PENDENTE)

  criadoEm DateTime @default(now()) @map("criado_em")

  lancamento Lancamento @relation(fields: [lancamentoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([situacao])
  @@index([lancamentoId])
  @@map("avisos_pagamento")
}

model ChavePix {
  id                 String       @id @default(uuid()) @db.Char(36)
  tipoChave          TipoChavePix @map("tipo_chave")
  chave              String       @db.VarChar(77)
  /// Limite do padrao BR Code EMV.
  nomeBeneficiario   String       @map("nome_beneficiario") @db.VarChar(25)
  /// Limite do padrao BR Code EMV.
  cidadeBeneficiario String       @map("cidade_beneficiario") @db.VarChar(15)
  padrao             Boolean      @default(false)
  ativa              Boolean      @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  contratos Contrato[]

  @@index([padrao])
  @@map("chaves_pix")
}

// ---------------------------------------------------------------------------
// Bloco 5: Apoio
// ---------------------------------------------------------------------------

/// Relacionamento polimorfico, sem FK, apontando para objetos no MinIO.
model Anexo {
  id            String        @id @default(uuid()) @db.Char(36)
  entidadeTipo  EntidadeAnexo @map("entidade_tipo")
  entidadeId    String        @map("entidade_id") @db.Char(36)
  especie       EspecieAnexo
  bucket        String        @db.VarChar(63)
  chaveObjeto   String        @map("chave_objeto") @db.VarChar(500)
  nomeArquivo   String        @map("nome_arquivo") @db.VarChar(255)
  tipoConteudo  String        @map("tipo_conteudo") @db.VarChar(100)
  tamanhoBytes  BigInt        @map("tamanho_bytes")
  checksum      String?       @db.VarChar(64)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([entidadeTipo, entidadeId])
  @@index([especie])
  @@map("anexos")
}

/// Parametros de negocio. Credenciais ficam em variaveis de ambiente.
model Configuracao {
  chave     String           @id @db.VarChar(80)
  valor     String           @db.Text
  tipo      TipoConfiguracao @default(TEXTO)
  grupo     String           @db.VarChar(50)
  descricao String?          @db.VarChar(200)

  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([grupo])
  @@map("configuracoes")
}

/// Feriados informados manualmente. Sabado e domingo o sistema reconhece sozinho.
model Feriado {
  id        String  @id @default(uuid()) @db.Char(36)
  data      DateTime @unique @db.Date
  descricao String   @db.VarChar(120)

  criadoEm DateTime @default(now()) @map("criado_em")

  @@map("feriados")
}

model Usuario {
  id        String        @id @default(uuid()) @db.Char(36)
  nome      String        @db.VarChar(150)
  email     String        @unique @db.VarChar(150)
  senhaHash String        @map("senha_hash") @db.VarChar(255)
  perfil    PerfilUsuario @default(ADMIN)
  ativo     Boolean       @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@map("usuarios")
}
